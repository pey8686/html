<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>貓咪好生活｜給家裡寶貝最安心的選擇</title>

    <style>

        /* =========================
           基本設定
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family:
                "Noto Sans TC",
                "Microsoft JhengHei",
                Arial,
                sans-serif;

            color: #263b37;
            background: #faf9f5;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            width: 100%;
            display: block;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        .container {
            width: 92%;
            max-width: 1200px;
            margin: auto;
        }


        /* =========================
           Header
        ========================= */

        header {
            background: #ffffff;
            height: 76px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #eeeeea;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-inner {
            width: 92%;
            max-width: 1400px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 180px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;

            background: #dfeee8;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 25px;
        }

        .logo-text {
            font-weight: 700;
            font-size: 20px;
        }

        .logo-sub {
            font-size: 10px;
            color: #78908a;
        }


        /* =========================
           Navigation
        ========================= */

        nav {
            display: flex;
            gap: 34px;
        }

        nav a {
            font-size: 15px;
            font-weight: 500;
            position: relative;
        }

        nav a:hover {
            color: #36796e;
        }

        nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -8px;

            width: 0;
            height: 2px;

            background: #36796e;
            transition: 0.3s;
        }

        nav a:hover::after {
            width: 100%;
        }


        /* =========================
           Header icons
        ========================= */

        .header-icons {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .search {
            border-bottom: 1px solid #bbb;
            padding: 6px 5px;
            color: #888;
        }

        .icon {
            font-size: 22px;
        }

        .cart {
            position: relative;
        }

        .cart-count {
            position: absolute;

            top: -8px;
            right: -10px;

            width: 18px;
            height: 18px;

            background: #d88a51;
            color: white;

            border-radius: 50%;

            font-size: 11px;

            display: flex;
            justify-content: center;
            align-items: center;
        }


        /* =========================
           Hero
        ========================= */

        .hero {
            min-height: 540px;

            background:
                linear-gradient(
                    90deg,
                    rgba(248,245,235,0.96) 0%,
                    rgba(248,245,235,0.85) 38%,
                    rgba(248,245,235,0.15) 75%
                ),

                url("images/hero-cat.jpg");

            background-size: cover;
            background-position: center;

            display: flex;
            align-items: center;
        }

        .hero-content {
            max-width: 550px;
            padding: 70px 0;
        }

        .hero-content h1 {
            font-size: clamp(40px, 5vw, 64px);
            line-height: 1.25;
            margin-bottom: 20px;
            letter-spacing: 3px;
        }

        .hero-content h1 span {
            color: #36796e;
        }

        .hero-content p {
            font-size: 19px;
            color: #536762;
            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 30px;
            border: none;
            font-size: 15px;
            transition: 0.3s;
        }

        .btn-primary {
            background: #36796e;
            color: white;
        }

        .btn-primary:hover {
            background: #285d54;
            transform: translateY(-2px);
        }

        .btn-outline {
            background: white;
            color: #36796e;
            border: 1px solid #36796e;
        }

        .btn-outline:hover {
            background: #36796e;
            color: white;
        }


        /* =========================
           Trust bar
        ========================= */

        .trust-bar {
            background: white;
            padding: 28px 0;

            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .trust-item {
            text-align: center;
            border-right: 1px solid #ddd;
        }

        .trust-item:last-child {
            border: none;
        }

        .trust-icon {
            font-size: 28px;
            margin-bottom: 5px;
        }

        .trust-item h3 {
            font-size: 16px;
        }

        .trust-item p {
            font-size: 12px;
            color: #888;
        }


        /* =========================
           Section
        ========================= */

        section {
            padding: 75px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-title small {
            color: #d18b56;
            font-weight: bold;
        }

        .section-title h2 {
            font-size: 32px;
            margin: 7px 0;
        }

        .section-title p {
            color: #777;
        }


        /* =========================
           Main categories
        ========================= */

        .main-products {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
        }

        .main-card {
            min-height: 310px;

            border-radius: 20px;

            padding: 40px;

            display: flex;
            align-items: center;

            overflow: hidden;

            position: relative;
        }

        .food-card {
            background: #dfeee7;
        }

        .litter-card {
            background: #f4e8d8;
        }

        .main-card-content {
            position: relative;
            z-index: 2;
            width: 55%;
        }

        .main-card h3 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .main-card p {
            color: #66756f;
            margin-bottom: 20px;
        }

        .main-card-image {
            position: absolute;

            width: 48%;
            right: -20px;
            bottom: -20px;

            border-radius: 20px;
        }

        .main-card .btn {
            padding: 10px 22px;
        }


        /* =========================
           Category cards
        ========================= */

        .category-grid {
            display: grid;

            grid-template-columns:
                repeat(6, 1fr);

            gap: 15px;
        }

        .category-card {
            background: white;
            border-radius: 15px;

            overflow: hidden;

            border: 1px solid #eee;

            transition: 0.3s;
        }

        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .category-card img {
            height: 150px;
            object-fit: cover;
        }

        .category-info {
            padding: 15px;
        }

        .category-info h3 {
            font-size: 15px;
            margin-bottom: 5px;
        }

        .category-info p {
            color: #999;
            font-size: 12px;
        }


        /* =========================
           Bundle
        ========================= */

        .bundle {
            background:
                linear-gradient(
                    90deg,
                    rgba(249,235,216,0.96),
                    rgba(249,235,216,0.75)
                ),

                url("images/happy-cat.jpg");

            background-size: cover;
            background-position: center;

            border-radius: 25px;

            min-height: 300px;

            display: flex;
            align-items: center;

            padding: 50px;
        }

        .bundle-content {
            max-width: 500px;
        }

        .bundle h2 {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .bundle p {
            color: #756c63;
            margin-bottom: 25px;
        }

        .price {
            font-size: 30px;
            color: #d25c39;
            font-weight: bold;
        }


        /* =========================
           Products
        ========================= */

        .products-grid {
            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 18px;
        }

        .product-card {
            background: white;

            border-radius: 15px;

            overflow: hidden;

            box-shadow: 0 4px 15px rgba(0,0,0,0.05);

            transition: 0.3s;

            position: relative;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            position: relative;
        }

        .product-image img {
            height: 190px;
            object-fit: cover;
        }

        .badge {
            position: absolute;

            top: 10px;
            left: 10px;

            background: #e99454;
            color: white;

            padding: 4px 9px;

            border-radius: 15px;

            font-size: 11px;
        }

        .product-info {
            padding: 15px;
        }

        .product-info h3 {
            font-size: 14px;
            margin-bottom: 10px;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-price {
            color: #d65c3e;
            font-size: 18px;
            font-weight: bold;
        }

        .add-cart {
            width: 34px;
            height: 34px;

            border-radius: 50%;

            border: none;

            background: #36796e;
            color: white;
        }


        /* =========================
           Brand Story
        ========================= */

        .brand-story {
            background: #e4eee9;
        }

        .brand-story-content {
            max-width: 850px;
            margin: auto;

            text-align: center;
        }

        .brand-story h2 {
            font-size: 38px;
            margin-bottom: 25px;
        }

        .brand-story p {
            color: #566761;
            font-size: 17px;
            margin-bottom: 18px;
        }

        .brand-quote {
            font-size: 25px !important;
            font-weight: bold;
            color: #36796e !important;

            margin-top: 30px;
        }


        /* =========================
           Member CTA
        ========================= */

        .member {
            padding: 65px 20px;

            background:
                linear-gradient(
                    90deg,
                    #f3dfca,
                    #f6e8d8
                );

            text-align: center;
        }

        .member h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .member p {
            color: #777;
            margin-bottom: 25px;
        }


        /* =========================
           Footer
        ========================= */

        footer {
            background: #263b37;
            color: white;

            padding: 60px 0 30px;
        }

        .footer-grid {
            display: grid;

            grid-template-columns:
                2fr 1fr 1fr 1fr;

            gap: 50px;

            margin-bottom: 50px;
        }

        footer h3 {
            margin-bottom: 15px;
        }

        footer p {
            color: #c2cfcb;
            font-size: 14px;
        }

        footer ul {
            list-style: none;
        }

        footer li {
            margin-bottom: 9px;
            color: #c2cfcb;
            font-size: 14px;
        }

        .copyright {
            border-top: 1px solid rgba(255,255,255,0.15);

            padding-top: 20px;

            text-align: center;

            color: #9eaaa7;

            font-size: 12px;
        }


        /* =========================
           RWD
        ========================= */

        @media (max-width: 900px) {

            nav {
                display: none;
            }

            .trust-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .category-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }


        @media (max-width: 600px) {

            header {
                height: 65px;
            }

            .logo-text {
                font-size: 16px;
            }

            .search {
                display: none;
            }

            .hero {
                min-height: 600px;
                background-position: 65% center;
            }

            .hero-content {
                padding-top: 230px;
            }

            .hero-content h1 {
                font-size: 36px;
            }

            .hero-content p {
                font-size: 16px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .trust-grid {
                grid-template-columns: 1fr 1fr;
            }

            .main-products {
                grid-template-columns: 1fr;
            }

            .main-card {
                min-height: 280px;
            }

            .category-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .product-image img {
                height: 150px;
            }

            .bundle {
                padding: 30px;
            }

            .bundle h2 {
                font-size: 27px;
            }

            .brand-story h2 {
                font-size: 28px;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>
</head>


